{
  "projects": [
    {
      "name": "cli-station",
      "kind": "станция",
      "what": "установка самих CLI: omp, pi, opencode (opencode2) на linux/macOS/Windows",
      "platforms": [
        "linux",
        "darwin",
        "win32"
      ],
      "run": "bin/cli-station.sh",
      "runWindows": "bin/cli-station.ps1",
      "tests": "tests/station.bats",
      "activate": [
        "status"
      ],
      "harnessStatus": "status --json",
      "update": "bin/cli-station.sh install",
      "updateWindows": "bin/cli-station.ps1 install"
    },
    {
